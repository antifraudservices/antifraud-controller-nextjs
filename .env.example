# Presentation-only deployment configuration. These values never grant authority.
CONTROLLER_PORTAL_NAME=Antifraud Controller
CONTROLLER_PORTAL_LOGO_URL=/brand/controller-mark.svg
CONTROLLER_PORTAL_ACCENT_COLOR=#075f68
CONTROLLER_PORTAL_SUPPORT_URL=https://github.com/antifraudservices/antifraud-controller-nextjs

# Synthetic demo authority is allowed only in local development or when an
# immutable staging deployment explicitly declares CONTROLLER_DEPLOYMENT_STAGE=staging.
# Test Network and production deployments always fail closed without trusted BFF evidence.
CONTROLLER_DEMO_MODE=false
CONTROLLER_DEPLOYMENT_STAGE=local

# Trusted BFF-only gateway configuration. Never expose the bearer to browser code.
ANTIFRAUD_GATEWAY_BASE_URL=http://127.0.0.1:3700
ANTIFRAUD_GATEWAY_BEARER=
