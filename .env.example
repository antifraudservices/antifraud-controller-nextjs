# Presentation-only deployment configuration. These values never grant authority.
CONTROLLER_PORTAL_NAME=Antifraud Controller
CONTROLLER_PORTAL_LOGO_URL=/brand/controller-mark.svg
CONTROLLER_PORTAL_ACCENT_COLOR=#075f68
CONTROLLER_PORTAL_SUPPORT_URL=https://github.com/antifraudservices/antifraud-controller-nextjs
# Optional private exact-host manifest. Never expose this as NEXT_PUBLIC_*.
# CONTROLLER_PORTAL_HOST_PROFILES_JSON={"controller-st.example.org":{"id":"neutral-controller","kind":"organization-controller","name":"Organization Controller","logoUrl":"/brand/controller-mark.svg","accentColor":"#075f68","supportUrl":"https://support.example.org/controller","modules":["organization","workforce","structure","evidence","clearing-house"],"allowedSectors":["health-care","animal-care","education"],"allowedJurisdictions":["ES","CA","US"],"enrollmentPolicy":"jurisdiction-provider"}}

# Synthetic demo authority is allowed only in local development or when an
# immutable staging deployment explicitly declares CONTROLLER_DEPLOYMENT_STAGE=staging.
# Test Network and production deployments always fail closed without trusted BFF evidence.
CONTROLLER_DEMO_MODE=false
CONTROLLER_DEPLOYMENT_STAGE=local
ANTIFRAUD_NETWORK_KIND=demo
ANTIFRAUD_DEMO_RETENTION_DAYS=7
ANTIFRAUD_TEST_NETWORK_ENABLED=false
ANTIFRAUD_PRODUCTION_ENABLED=false

# Trusted BFF-only gateway configuration. Never expose the bearer to browser code.
ANTIFRAUD_GATEWAY_BASE_URL=http://127.0.0.1:3700
ANTIFRAUD_GATEWAY_BEARER=

# Separate host-operator BFF configuration. The subject must match the
# gateway's configured host administrator in local/staging demo mode.
HOST_CONTROLLER_DEMO_MODE=false
HOST_CONTROLLER_DEMO_SUBJECT=
SOS_GATEWAY_HOST_BASE_URL=http://127.0.0.1:3700
SOS_GATEWAY_HOST_BEARER=
SOS_GATEWAY_HOST_JURISDICTION=ES
SOS_GATEWAY_HOST_NETWORK=test
SOS_GATEWAY_HOST_APP_ID=http://localhost:3600

# Trusted BFF-only terminology configuration. The browser calls the Controller
# BFF and never receives this service credential.
TERMINOLOGY_BASE_URL=http://127.0.0.1:3720
TERMINOLOGY_SERVICE_TOKEN=
